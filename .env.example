# Copy to .env and replace <DB_PASSWORD> with your Supabase database password.
# Use the Session pooler URL from the project's Connect dialog (IPv4 compatible).
# Keep .env local; it is git-ignored.
DATABASE_URL=postgresql://postgres.ctiyyxjrkurepogcfhoj:<DB_PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
PORT=5001
HOST=0.0.0.0
# Supabase Auth configuration. The publishable key is safe for browser use.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
VITE_API_URL=http://127.0.0.1:5001/api

# Server-only key used to encrypt each user's Intervals.icu API key (32 random bytes, hex).
# Generate with: openssl rand -hex 32
INTERVALS_CREDENTIAL_ENCRYPTION_KEY=
